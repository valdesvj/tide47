    X>Y?
    IF 79
      1
      STO 20
    ENDIF 79
    RCL 20
    XEQ 04                      ; -> :HAS:
    X=0?
  WHILE 23
  ENDDO 23
  1
  STO 21
  STO 92
ENDIF 78
RTN
END
