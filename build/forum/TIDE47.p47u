@ ---- LBL :PROBE: the data programs loaded (LBL? "TIDEME" ...: the build writes one block a region) and of this
@ version (X = 0 sets R93 = the number of constituents: an older one does not): R79 = the sum of 2^(region - 1)
@ of those found; R92 how many older ones (their names in R94, shown 3 s); none: NO TIDE DATA (3 s) and the end;
@ R20 the first region found ----
LBL 02                          ; :PROBE:
0
STO 79
STO 92
"OLD DATA, REBUILD:"
STO 94
@ the data programs TIDEME TIDEUS TIDELA TIDECU (written by the build)
0
STO 93
STO 96
LBL? "TIDEME"
XEQ "TIDEME"
RCL 96
X≠0?
IF 02
  3060
  RCL 93
  X=Y?
  IF 03
    1
    STO+ 79
  ELSE 03
    " TIDEME"
    x→α 94
    1
    STO+ 92
  ENDIF 03
ENDIF 02
0
STO 93
STO 96
LBL? "TIDEUS"
XEQ "TIDEUS"
RCL 96
X≠0?
IF 04
  3060
  RCL 93
  X=Y?
  IF 05
    2
    STO+ 79
  ELSE 05
    " TIDEUS"
    x→α 94
    1
    STO+ 92
  ENDIF 05
ENDIF 04
0
STO 93
STO 96
LBL? "TIDELA"
XEQ "TIDELA"
RCL 96
X≠0?
IF 06
  3060
  RCL 93
  X=Y?
  IF 07
    4
    STO+ 79
  ELSE 07
    " TIDELA"
    x→α 94
    1
    STO+ 92
  ENDIF 07
ENDIF 06
0
STO 93
STO 96
LBL? "TIDECU"
XEQ "TIDECU"
RCL 96
X≠0?
IF 08
  3060
  RCL 93
  X=Y?
  IF 09
    8
    STO+ 79
  ELSE 09
    " TIDECU"
    x→α 94
    1
    STO+ 92
  ENDIF 09
ENDIF 08
RCL 92
X≠0?
IF 10
  RCL 94
  XEQ 03                        ; -> :MSG:
ENDIF 10
RCL 79
X=0?
IF 11
  "NO TIDE DATA PROGRAM LOADED"
  XEQ 03                        ; -> :MSG:
  RTN
ENDIF 11
0
